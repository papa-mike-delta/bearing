# Environment Variables

# Database (PostgreSQL)
# Local example: create a database named bearing in your local PostgreSQL server.
# Hosted example: use your PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bearing

# Session secret (change this in production!)
# Production requires a unique random secret of at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Conversational Coach (server only). Both provider and model must be configured.
BEARING_COACH_PROVIDER=openrouter
BEARING_COACH_MODEL=
OPENROUTER_API_KEY=
# For BEARING_COACH_PROVIDER=gateway:
AI_GATEWAY_API_KEY=
# Optional trusted server proxy for OpenRouter, e.g. a local deterministic test server.
# BEARING_COACH_OPENROUTER_URL=https://openrouter.ai/api/v1
