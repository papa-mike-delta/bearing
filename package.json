{
  "name": "bearing-now",
  "version": "0.2.0",
  "description": "Capture, organize, connect and recall personal information with Daily Journal, connected Items and approval-gated Coach.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "bearing-now",
    "digital-brain",
    "second-brain",
    "personal-knowledge-management",
    "productivity",
    "self-hosted",
    "habit-tracker",
    "open-source-habit-tracker",
    "daily-habit-tracker",
    "journal",
    "journal-app",
    "task-manager",
    "focus-timer",
    "pomodoro",
    "knowledge-graph",
    "personal-dashboard",
    "nextjs",
    "prisma",
    "pwa"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/papa-mike-delta/bearing-now.git"
  },
  "bugs": {
    "url": "https://github.com/papa-mike-delta/bearing-now/issues"
  },
  "homepage": "https://github.com/papa-mike-delta/bearing-now#readme",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prepare-offline.mjs && prisma generate && next build",
    "build:vercel": "node scripts/prepare-offline.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "theme:generate": "tsx scripts/generate-theme.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "db:invite": "node --import tsx scripts/create-invitation.ts"
  },
