{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["POSTGRES_URL", "POSTGRES_URL_NON_POOLING", "AUTH_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@repo/db#db:migrate:vercel"],
      "passThroughEnv": [
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "BEARING_VERCEL_BUILD"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@repo/db#db:migrate:vercel": {
      "cache": false,
      "passThroughEnv": [
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "BEARING_VERCEL_BUILD",
        "PRODUCTION_DB_HOST"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["TEST_POSTGRES_URL", "CI"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
